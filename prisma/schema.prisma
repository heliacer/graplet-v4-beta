datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @unique
  password  String
  createdAt DateTime @default(now())
  role      Role     @default(USER)
}

enum Role {
  USER
  TESTER
  EARLY_ACCESS
  ADMIN
}
